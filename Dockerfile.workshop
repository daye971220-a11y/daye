FROM node:24-bookworm-slim
WORKDIR /app
COPY server/package*.json ./server/
RUN cd server && npm ci --omit=dev
COPY server/src ./server/src
COPY public ./public
COPY research ./research
ENV NODE_ENV=production PORT=4000 WORKSHOP_DATA_DIR=/data/workshop
EXPOSE 4000
WORKDIR /app/server
CMD ["node", "src/workshop-server.js"]
