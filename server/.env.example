# https://developers.naver.com 에서 애플리케이션 등록 후 "검색" API를 사용 설정하면 발급됩니다.
NAVER_CLIENT_ID=여기에_클라이언트_아이디
NAVER_CLIENT_SECRET=여기에_클라이언트_시크릿

# 서버 포트
PORT=4000

# 몇 분마다 뉴스를 수집할지 (기본 10분)
COLLECT_INTERVAL_MIN=10

# 디스코드 채널 설정 > 연동 > 웹후크 > 새 웹후크 만들기 → URL 복사해서 붙여넣기
# 비워두면 알림 기능은 그냥 꺼진 채로 동작 (사이트 자체는 영향 없음)
DISCORD_WEBHOOK_URL=

# 네이버 검색광고(searchad.naver.com) API 키 3종 — "키워드 리서치" 탭(PC/모바일 검색량,
# 광고 경쟁도)에 필요. developers.naver.com 오픈 API 키(NAVER_CLIENT_ID/SECRET)와는
# 완전히 별개. 광고주 가입 후 [도구 > API 사용 관리]에서 발급 (무료, 사업자 없이 개인
# 광고주로도 가능). 비워두면 "키워드 리서치" 탭만 비활성화되고 나머지 사이트는 정상 동작.
NAVER_AD_API_KEY=여기에_API_License
NAVER_AD_SECRET_KEY=여기에_Secret_Key
NAVER_AD_CUSTOMER_ID=여기에_고객번호(6~8자리_숫자)
