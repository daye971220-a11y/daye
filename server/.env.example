# https://developers.naver.com 에서 애플리케이션 등록 후 "검색" API를 사용 설정하면 발급됩니다.
NAVER_CLIENT_ID=여기에_클라이언트_아이디
NAVER_CLIENT_SECRET=여기에_클라이언트_시크릿

# 서버 포트
PORT=4000

# 몇 분마다 뉴스를 수집할지 (기본 10분)
COLLECT_INTERVAL_MIN=10

# 디스코드 채널 설정 > 연동 > 웹후크 > 새 웹후크 만들기 → URL 복사해서 붙여넣기
# 비워두면 알림 기능은 그냥 꺼진 채로 동작 (사이트 자체는 영향 없음)
DISCORD_WEBHOOK_URL=
