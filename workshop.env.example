# Configure these as private environment variables on the shared server.
PORT=4000
WORKSHOP_DATA_DIR=/data/workshop
WORKSHOP_PUBLIC_URL=https://your-studio.example.com
# Choose a separate password with at least 10 characters; do not commit it.
WORKSHOP_PASSWORD=
# Optional here: the owner can also enter the key in the private studio settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
